# ===== 应用 =====
# development=本地全 Mock；test=允许分组件联调；production=Compose/正式部署
APP_ENV=development
APP_HOST=127.0.0.1
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change-me

# ===== JWT 鉴权（MOCK_MODE=false 时必填）=====
JWT_ALGORITHM=HS256
JWT_SIGNING_SECRET=
JWT_ISSUER=business-auth
JWT_AUDIENCE=pet-consult
JWT_REQUIRED_SCOPE=pet:consult

# ===== 日志脱敏 =====
LOG_HASH_SECRET=

# ===== 本地开发 Mock（全部 true = 无需任何外部服务）=====
MOCK_MODE=true
MOCK_VISION=true
MOCK_KNOWLEDGE_CONSULT=true
MOCK_GUARD=true

# ===== Vision 服务 =====
VISION_GATEWAY_BASE_URL=http://127.0.0.1:8102
VISION_SCENE=pet_consult_image
VISION_PRIORITY=0
VISION_TIMEOUT_SECONDS=15
VISION_CONCURRENCY=4
VISION_MAX_QUEUE_SIZE=12
# 图片回归通过前保持 512；之后可 A/B 320。
VISION_MAX_TOKENS=512
VISION_CACHE_ENABLED=true
VISION_CACHE_TTL_SECONDS=86400
CONSULT_VISION_MODEL_NAME=Qwen3.5-4B
CONSULT_GUARD_MODEL_NAME=Qwen3Guard-Gen-0.6B

# ===== KnowledgeConsult API =====
KNOWLEDGE_PROVIDER=deepseek_official
KNOWLEDGE_API_BASE_URL=https://api.deepseek.com
KNOWLEDGE_API_KEY=
KNOWLEDGE_MODEL=deepseek-v4-flash
KNOWLEDGE_THINKING_MODE=disabled
KNOWLEDGE_TIMEOUT_SECONDS=20
KNOWLEDGE_CONNECT_TIMEOUT_SECONDS=10
KNOWLEDGE_CONNECT_RETRIES=1

# ===== RAG Shadow（只读记录，不影响用户回答） =====
RAG_MODE=shadow
RAG_INDEX_PATH=
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.24
RAG_EMERGENCY_SHADOW=true

# ===== Guard 服务 =====
GUARD_BASE_URL=http://127.0.0.1:8103
GUARD_INPUT_TIMEOUT_MS=1500
GUARD_OUTPUT_TIMEOUT_MS=1500
GUARD_MODE=off

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=pet_consult
REDIS_PASSWORD=
REDIS_TTL_SECONDS=604800
MAX_CONVERSATION_TURNS=20

# ===== 图片限制 =====
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_EDGE=1024
MAX_IMAGE_PIXELS=20000000

# ===== 超时 =====
CONSULT_TOTAL_TIMEOUT_SECONDS=45
SAFETY_REWRITE_TIMEOUT_SECONDS=15

# ===== 开关 =====
ENABLE_ADMIN_API=false

# ===== 限流 =====
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# ===== 队列化（Phase 2：任务表 + Outbox + RocketMQ）=====
# 问诊使用独立 RocketMQ 实例（集群 pet-consult，namesrv :9877 / broker :10912），
# 与审核系统 pet-moderation 的 :9876/:10911 完全隔离。启动见 scripts/rocketmq_consult.sh。
CONSULT_MQ_ENABLED=false
CONSULT_MQ_NAMESRV_ADDR=127.0.0.1:9877
# pyrocketmq（JPype 桥接 Java 客户端）依赖的 RocketMQ 4.9.8 发行包 lib/* classpath
CONSULT_MQ_CLASSPATH=/root/autodl-tmp/tools/rocketmq-all-4.9.8-bin-release/lib/*
CONSULT_MQ_TOPIC=consult-tasks
CONSULT_MQ_GROUP=consult-worker-group
CONSULT_MQ_DLQ_TOPIC=consult-tasks-dlq
CONSULT_MQ_MAX_RETRY=3
CONSULT_OUTBOX_SCAN_SECONDS=5
CONSULT_WORKER_COUNT=10
QUEUE_MAX_PENDING=12
# v7.3：两项同时为正时启用分类准入；均为 0 时兼容 v7.2 全局上限。
TEXT_MAX_ACTIVE=0
IMAGE_MAX_ACTIVE=0
# 按图片数加权的视觉槽位；0 表示不启用加权限制。
IMAGE_MAX_ACTIVE_SLOTS=0
QUEUE_ACTIVE_STALE_SECONDS=120
CONSULT_SSE_STREAM_TTL_SECONDS=300
CONSULT_DB_POOL_SIZE=20
CONSULT_DB_MAX_OVERFLOW=10
CONSULT_DB_POOL_TIMEOUT_SECONDS=10
CONVERSATION_LOCK_WAIT_SECONDS=20
CONVERSATION_LOCK_LEASE_SECONDS=95
TEXT_VLLM_MAX_NUM_SEQS=16
VISION_VLLM_MAX_NUM_SEQS=16
