# Nginx / API Gateway —— 8×RTX5090 服务器专用（2026-08-20 生成）
# 用法：apt install nginx 后替换 /etc/nginx/nginx.conf（或 include 进主配置）
# 监听 80（HTTP）；如需 HTTPS 把 listen 80 换成 443 ssl 并配置证书。
# 原则：只有本网关对公网暴露；问诊 API(8100)/审核 API(8110) 只监听 127.0.0.1。

worker_processes 4;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log warn;

events {
    worker_connections 1024;
}

http {
    server_tokens off;
    access_log /var/log/nginx/access.log;

    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        ""      $scheme;
    }

    # 信任前置代理（云负载均衡/安全组转发时保留真实客户端 IP；纯直连可保留）
    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # 透传调用方 trace ID；缺失时用 nginx 自生成 request_id
    map $http_x_request_id $forwarded_request_id {
        default $http_x_request_id;
        ""      $request_id;
    }

    # ---- 请求体限制（图片 ≤3 张 × 5MB + 表单余量）----
    client_max_body_size 20m;
    client_body_timeout 30s;
    client_body_temp_path /var/lib/nginx/tmp 1 2;

    # ---- 限流（IP 级兜底，默认关闭；业务级限流在 FastAPI，mock 模式放行）----
    limit_req_status 429;

    upstream consult_api {
        server 127.0.0.1:18100;
        keepalive 16;
    }

    upstream moderation_api {
        server 127.0.0.1:18110;
        keepalive 16;
    }

    server {
        listen 80;
        server_name _;

        default_type application/json;

        error_page 413 = @payload_too_large;
        error_page 429 = @rate_limited;

        # 健康检查
        location /health/ {
            proxy_pass http://consult_api;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Request-Id $forwarded_request_id;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            access_log off;
        }

        # SSE 必须关闭代理缓冲，否则后端会在连接末尾一次性收到所有事件。
        # 超时 75s > 业务 SSE 总等待上限(consult_sse_max_wait_seconds=60s)
        location = /api/v1/consult/stream {
            proxy_pass http://consult_api;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Connection "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Request-Id $forwarded_request_id;
            proxy_buffering off;
            proxy_cache off;
            gzip off;
            add_header X-Accel-Buffering no always;
            proxy_read_timeout 75s;
            proxy_send_timeout 75s;
        }

        # 公网审核接口使用统一的 /api/v1 前缀，后端仍保持 internal 路由。
        location /api/v1/moderation/ {
            proxy_pass http://moderation_api/internal/moderation/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Connection "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Request-Id $forwarded_request_id;
            proxy_read_timeout 120s;
            proxy_send_timeout 30s;
        }

        # 业务后端（pet-backend）C 端接口：发帖/问诊转发/JWT 签发（2026-08-21）
        location /api/biz/ {
            proxy_pass http://127.0.0.1:18080;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Connection "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Request-Id $forwarded_request_id;
            proxy_read_timeout 90s;
            proxy_send_timeout 90s;
        }

        # 普通问诊接口。使用精确匹配，避免将管理接口意外暴露到公网。
        # 超时 75s > 业务队列等待上限(consult_wait_result_timeout_seconds=60s)
        location = /api/v1/consult {
            proxy_pass http://consult_api;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Connection "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Request-Id $forwarded_request_id;
            proxy_read_timeout 75s;
            proxy_send_timeout 75s;
        }

        # 会话读取和删除接口。
        location /api/v1/conversations/ {
            proxy_pass http://consult_api;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Connection "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Request-Id $forwarded_request_id;
            proxy_read_timeout 75s;
            proxy_send_timeout 75s;
        }

        location @payload_too_large {
            return 413 '{"status":"error","error":{"code":"PAYLOAD_TOO_LARGE","message":"请求体超过 20MB","retryable":false}}';
        }

        location @rate_limited {
            return 429 '{"status":"error","error":{"code":"RATE_LIMITED","message":"请求过于频繁，请稍后再试","retryable":true}}';
        }

        # 其余一律 404（不暴露其他路径）
        location / {
            return 404 '{"status":"error","error":{"code":"NOT_FOUND","message":"接口不存在","retryable":false}}';
        }
    }
}
