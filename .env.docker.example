# Copy to .env.docker. This stack is isolated from pet-moderation.
# ===== 8×RTX5090 新服务器部署（2026-08-20 更新）=====
# 模型目录：/home/x17/models（含 Qwen3.5-4B(VL)/Qwen3.5-9B/Qwen3Guard-Gen-0.6B/bge-m3）
# GPU 分配（当前服务器）：问诊文本 GPU2、视觉 GPU3；审核视觉 GPU4、Guard GPU5。
# 鉴权：AUTH_SKIP=true 跳过 JWT（调用方带 X-User-Id 头）；不限流 RATE_LIMIT_ENABLED=false
# ===== 必填 =====
MODEL_DIR=/home/x17/models
# 部署必改：数据库/Redis 密码（与 .env 变量替换文件一致），不要留 change-me
# 生产部署时分别设置数据库与 Redis 密码，不要保留占位值。
PG_PASSWORD=change-me
REDIS_PASSWORD=change-me
VISION_GPU_DEVICE=3
TEXT_GPU_DEVICE=2

CONSULT_API_PORT=18100
# 问诊独立 RocketMQ(与审核系统 :9876/:10911 隔离)
ROCKETMQ_NAMESRV_PORT=9877
ROCKETMQ_BROKER_PORT=10912
CONSULT_GPU_DEVICE=3
CONSULT_VISION_MODEL_PATH=/home/x17/models/Qwen3.5-4B
CONSULT_VISION_MODEL_NAME=Qwen3.5-4B
CONSULT_GUARD_MODEL_NAME=Qwen3Guard-Gen-0.6B
VLLM_IMAGE=vllm/vllm-openai:v0.27.1
# 2026-08-19: v0.26(cu128) 在 SM120 上仅 44 t/s, 必须 v0.27.1(cu13)
CONSULT_VLLM_MAX_MODEL_LEN=8192
# 显存占用率（5090 32G 跑 9B 很宽松；0.85=约27G，不用改小）
TEXT_GPU_MEMORY_UTILIZATION=0.85
VISION_GPU_MEMORY_UTILIZATION=0.85
# v7.2：文本/视觉 vLLM 参数已拆分；这三个值部署时也必须写入 Compose 的 .env。
TEXT_VLLM_MAX_NUM_SEQS=16
VISION_VLLM_MAX_NUM_SEQS=16
# VisionGateway 实际并发。
VISION_CONCURRENCY=4
VISION_MAX_QUEUE_SIZE=12
# 先用 512 回归 image-01/02/03；通过后再 A/B 为 320（截断则用 384/512）。
VISION_MAX_TOKENS=512
VISION_CACHE_ENABLED=true
VISION_CACHE_TTL_SECONDS=86400
VISION_MAX_REQUEST_SECONDS=45

APP_ENV=production
APP_SECRET_KEY=change-me
# 2026-08-20: 跳过 JWT 鉴权（改用 X-User-Id 头做用户隔离）；对外开放前改回 false 并配密钥
AUTH_SKIP=true
JWT_ALGORITHM=HS256
JWT_SIGNING_SECRET=change-me
JWT_ISSUER=business-auth
JWT_AUDIENCE=pet-consult
JWT_REQUIRED_SCOPE=pet:consult
LOG_HASH_SECRET=change-me
# 2026-08-20: 关闭限流（内部部署）；对外开放前改回 true 并按需调 RATE_LIMIT_MAX
RATE_LIMIT_ENABLED=false

# 2026-08-21: 纯本地生成——不再依赖 DeepSeek API。
# 生成：RAG(bge-m3 检索知识卡片) + Qwen3.5-9B(vLLM, 容器内 :8002)
KNOWLEDGE_PROVIDER=local_openai
KNOWLEDGE_API_BASE_URL=http://consult-vllm-text:8002/v1
KNOWLEDGE_API_KEY=
KNOWLEDGE_MODEL=Qwen3.5-9B
KNOWLEDGE_THINKING_MODE=disabled
KNOWLEDGE_TIMEOUT_SECONDS=20
KNOWLEDGE_CONNECT_TIMEOUT_SECONDS=10
KNOWLEDGE_CONNECT_RETRIES=1

GUARD_MODE=off
# 2026-08-21: grounded=知识卡片证据注入 9B 生成（纯本地回答）；
RAG_MODE=grounded
RAG_FAST_ANSWER=false
RAG_FAST_ANSWER_THRESHOLD=0.40
REDIS_TTL_SECONDS=604800
MAX_CONVERSATION_TURNS=20
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_EDGE=1024
MAX_IMAGE_PIXELS=20000000
VISION_TIMEOUT_SECONDS=45
CONSULT_TOTAL_TIMEOUT_SECONDS=80
SAFETY_REWRITE_TIMEOUT_SECONDS=15
ENABLE_ADMIN_API=false
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60
# ===== 队列削峰（2026-08-20）=====
# v7.3 候选压测起点；必须经冷缓存和混合流量验证后才能作为生产结论。
CONSULT_WORKER_COUNT=14
# 排队有界等待：超过返回 TASK_TIMEOUT(retryable)；nginx 网关超时已对齐 75s
CONSULT_WAIT_RESULT_TIMEOUT_SECONDS=85
# SSE 排队总等待上限：超过发 error(QUEUE_TIMEOUT, retryable)
CONSULT_SSE_MAX_WAIT_SECONDS=85
# 分类准入启用后 QUEUE_MAX_PENDING 仅作为 v7.2 回滚兼容值。
QUEUE_MAX_PENDING=20
TEXT_MAX_ACTIVE=24
IMAGE_MAX_ACTIVE=6
# 单图消耗 1、三图消耗 3；先以当前视觉网关总任务上限 12 为保守起点。
IMAGE_MAX_ACTIVE_SLOTS=12
QUEUE_ACTIVE_STALE_SECONDS=120
CONSULT_SSE_STREAM_TTL_SECONDS=300
CONSULT_DB_POOL_SIZE=20
CONSULT_DB_MAX_OVERFLOW=10
CONSULT_DB_POOL_TIMEOUT_SECONDS=10
CONVERSATION_LOCK_WAIT_SECONDS=20
CONVERSATION_LOCK_LEASE_SECONDS=95
